# The edge for the whole app: TLS for {$DOMAIN}, the static build, and /api
# forwarded to the API container. DOMAIN and API_UPSTREAM come from the
# environment, so the same image serves localhost and the real hostname.

{$DOMAIN:localhost} {
	encode zstd gzip

	# The API already answers under /api, so nothing is rewritten: the backend
	# mounts its router at /api in development too, and the paths must match.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8280}
	}

	# Vite fingerprints everything under /assets, so those can never go stale -
	# and a miss has to stay a miss. Answering a missing module with the app shell
	# is what turns a stale index.html into "blocked because of a disallowed MIME
	# type (text/html)": the browser asked for a module and was handed HTML.
	handle /assets/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# SPA: any path that is not a file on disk is the app's own route, which is
	# what createBrowserRouter needs for a deep link into /lectures/:id.
	#
	# The shell is revalidated on every load. Without that a browser caches it
	# heuristically, keeps yesterday's script names after a deploy, asks for
	# assets the new build no longer has, and shows a white page - a deploy that
	# looks like it never happened.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
