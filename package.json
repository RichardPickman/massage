{
    "name": "massage",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "eject": "vite eject",
        "prettier": "prettier --write .",
        "prettier:check": "git diff --name-only --diff-filter=ACMRTUXB master -- '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' '*.md' '*.css' | xargs -r prettier --check",
        "eslint": "eslint ."
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource/roboto": "^4.5.8",
        "@formkit/auto-animate": "^0.10.0",
        "@phosphor-icons/react": "^2.1.10",
        "@reduxjs/toolkit": "^1.9.1",
        "@tailwindcss/vite": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.4.0",
        "dayjs": "^1.11.7",
        "immutability-helper": "^3.1.1",
        "jwt-decode": "^3.1.2",
        "radix-ui": "^1.6.7",
        "react": "^18.2.0",
        "react-day-picker": "^10.0.1",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dom": "^18.2.0",
        "react-redux": "^8.0.5",
        "react-router-dom": "^6.4.2",
        "shadcn": "^4.21.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.31.10",
        "globals": "^17.12.0",
        "jsdom": "^30.1.3",
        "prettier": "^2.7.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.5"
    }
}
